{
  "expo": {
    "name": "OneScan",
    "slug": "onescan",
    "scheme": "onescan",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.onescan.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock your private documents."
      },
      "buildNumber": "6"
    },
    "android": {
      "package": "app.onescan.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0052D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 13,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "OneScan uses the camera to scan documents. Images are processed on your device.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OneScan imports photos you choose to create documents on your device."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://jitpack.io"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ],
            "extraProguardRules": "# OneScan native module: Expo modules reflect on records and views.\n-keep class app.onescan.vision.** { *; }\n# Tesseract (JNI calls back into these classes).\n-keep class com.googlecode.tesseract.android.** { *; }\n-keep class com.googlecode.leptonica.android.** { *; }\n# SQLCipher-enabled expo-sqlite native bindings.\n-keep class expo.modules.sqlite.** { *; }"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withPrivacyHardening",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

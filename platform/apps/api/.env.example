NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ship
REDIS_URL=redis://localhost:6379
# Generate real secrets for any shared environment: openssl rand -base64 32
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
DATA_ENCRYPTION_KEY=ZGV2LW9ubHktZGF0YS1rZXktY2hhbmdlLW1lLTAwMDE=
HASH_PEPPER=dev-only-pepper-change-me
UPLOAD_SIGNING_SECRET=dev-only-upload-secret

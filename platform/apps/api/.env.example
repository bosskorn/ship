OTP_DEV_ECHO=true
OTP_DEV_FIXED_CODE=123456
ROUTING_PROVIDER=haversine
# OSRM_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
LOG_LEVEL=info

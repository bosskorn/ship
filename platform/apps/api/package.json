{
  "name": "@ship/api",
  "version": "0.1.0",
  "private": true,
  "description": "Core backend: auth, quote, pricing, order, dispatch, tracking, payments, ops",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "demo": "node --env-file-if-exists=.env dist/scripts/demo-e2e.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "simulate": "node --env-file-if-exists=.env dist/scripts/simulate-drivers.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/websockets": "11.1.6",
    "@ship/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "5.58.5",
    "express": "5.1.0",
    "ioredis": "5.7.0",
    "jose": "5.10.0",
    "nestjs-pino": "4.4.0",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "concurrently": "9.2.1",
    "pino-pretty": "13.1.1",
    "socket.io-client": "4.8.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
